desc:Increment CC Values on each press (CrazyJ36)

in_pin:none
out_pin:none

@init
ext_no_init = 1.0;
value = 0;
// increment = 127 / slider incrementer.
increment = 32;

@gfx
gfx_set(1, 1, 1, 1);
gfx_x = 1;
gfx_y = 1;
gfx_drawstr("CC Value Incrementer for Amp Channels.\n\n");
gfx_drawnumber(value, 0);

@block
while (midirecv(offset, msg1, msg2, msg3)) (
    msg2 == 4 ? (
   
      value = value + increment;
     
      value == 128 ? (
        value = 0;
      );
      
      midisend(offset, msg1, msg2, value);
    )
);
